# Copy to .env and replace the placeholders before starting.
POSTGRES_USER=menenwbkam
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql://menenwbkam:replace-with-a-local-database-password@localhost:5432/menenwbkam
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=3000
WEB_ORIGIN=http://localhost:3001
# Server-side Next.js rewrite target. Browsers use /api.
API_URL=http://127.0.0.1:3000
# Private verification files; never expose this directory as static files.
UPLOAD_DIR=./uploads
# Optional services
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=replace-with-a-random-search-key
# Seed creates an admin only when both are supplied. No default admin password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Integration tests require a separate disposable database with migrations applied.
TEST_DATABASE_URL=
# Optional API-hosted scheduler; the standalone `npm run scheduler --workspace=api`
# command works independently. Run a separate `npm run worker --workspace=api`.
# Queue and GIN search index use PostgreSQL; no Redis/Meilisearch is required.
EXTERNAL_SYNC_ENABLED=false
# Conservative per-store crawling limits, shared by all worker processes.
EXTERNAL_CRAWL_MIN_DELAY_MS=5000
EXTERNAL_CRAWL_JITTER_MS=3000
EXTERNAL_CRAWL_HOURLY_BUDGET=120
EXTERNAL_CRAWL_DAILY_BUDGET=1000
# Optional direct Chrome collection for Noon and eXtra. HTTP mode stays the default.
EXTERNAL_BROWSER_ENABLED=false
# Optional when Chrome is installed at a standard Windows/Linux location.
EXTERNAL_BROWSER_EXECUTABLE=
# Phase 2: local simulation only; test payments are always disabled in production.
BILLING_MODE=test
BILLING_VAT_BPS=1500
BILLING_BUSINESS_NAME=Menenwbkam (test)
BILLING_VAT_NUMBER=
