# Comparison-only launch. Copy to .env; never commit actual credentials.
POSTGRES_USER=menenwbkam
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql://menenwbkam:replace-with-a-local-database-password@localhost:5432/menenwbkam
PORT=3000
WEB_ORIGIN=http://localhost:3001
# Server-only URL and shared credential, used by the Next.js API proxy.
API_URL=http://127.0.0.1:3000
API_PROXY_SECRET=
# Local origin below; set https://menenwbkam.com for production builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# No automatic public search admission until worker monitoring/firewall limits exist.
PUBLIC_DISCOVERY_ENABLED=false
# API does not host the scheduler. Run separate scheduler and worker processes.
EXTERNAL_SYNC_ENABLED=false
EXTERNAL_CRAWL_MIN_DELAY_MS=5000
EXTERNAL_CRAWL_JITTER_MS=3000
EXTERNAL_CRAWL_HOURLY_BUDGET=120
EXTERNAL_CRAWL_DAILY_BUDGET=1000
# Only on a deliberately configured collection host, not the Vercel request API.
EXTERNAL_BROWSER_ENABLED=false
EXTERNAL_BROWSER_EXECUTABLE=
# For the preserved marketplace integration suite, use a disposable *_test DB only.
TEST_DATABASE_URL=
